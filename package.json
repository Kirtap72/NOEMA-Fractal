{
  "name": "noema-fractal",
  "version": "1.0.0",
  "main": "desktop/main.cjs",
  "private": true,
  "description": "Modern fractal engine with real-time preview (WebGPU + TypeScript)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop:build": "tsc --noEmit && node tools/desktop/build.mjs",
    "desktop:start": "electron desktop/main.cjs",
    "desktop:pack": "node tools/desktop/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@webgpu/types": "^0.1.74",
    "ajv": "^8.20.0",
    "electron": "44.7.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
